# ─── PhishGuard Environment Variables ───
# Copy this file to .env and fill in your values

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://phishguard:phishguard_secret@postgres:5432/phishguard
DATABASE_URL_SYNC=postgresql://phishguard:phishguard_secret@postgres:5432/phishguard

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Qdrant ───
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── Clerk Authentication ───
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_KEY
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_KEY
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_KEY

# ─── Groq LLM ───
GROQ_API_KEY=REPLACE_WITH_YOUR_KEY
GROQ_MODEL=llama-3.1-70b-versatile

# ─── Threat Intelligence ───
VIRUSTOTAL_API_KEY=REPLACE_WITH_YOUR_KEY
ABUSEIPDB_API_KEY=REPLACE_WITH_YOUR_KEY
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1

# ─── Extension ───
EXTENSION_API_KEY=REPLACE_WITH_YOUR_KEY

# ─── Rate Limiting ───
RATE_LIMIT_EXTENSION=100
RATE_LIMIT_ANALYST=1000

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,chrome-extension://*

# ─── Server ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# ─── Dashboard (Next.js) ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PhishGuard
