# ─── PhishGuard Environment Variables ───

# ─── Upstash Redis ───
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Clerk Authentication ───
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# ─── Google Gemini LLM ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Threat Intelligence ───
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1

# ─── Extension ───
EXTENSION_API_KEY=

# ─── Rate Limiting ───
RATE_LIMIT_EXTENSION=100
RATE_LIMIT_ANALYST=1000

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,chrome-extension://*,https://*.vercel.app

# ─── Server ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# ─── Dashboard (Next.js) ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PhishGuard
